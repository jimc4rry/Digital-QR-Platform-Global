msgstr "Αριθμός τηλεφώνου"

msgid "Email address"
msgstr "Διεύθυνση email"

msgid "Subject (optional)"
msgstr "Θέμα (προαιρετικό)"

msgid "Message (optional)"
msgstr "Μήνυμα (προαιρετικό)"

